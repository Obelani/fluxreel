# Copie estas variáveis pro projeto na Vercel (Settings > Environment Variables).
# Nunca commitar um arquivo .env de verdade — só este .env.example com placeholders.

# ---- Supabase (já existe o projeto, só falta a service_role key aqui) ----
SUPABASE_URL=https://kbcagxxwhenqubbktsiv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INICIAL_MONTHLY=
STRIPE_PRICE_INICIAL_ANNUAL=
STRIPE_PRICE_DIARIO_MONTHLY=
STRIPE_PRICE_DIARIO_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# ---- Pipeline de geração de vídeo ----
ANTHROPIC_API_KEY=
# fal.ai — hospeda o Z-Image Turbo. Pegar em fal.ai/dashboard/keys
FAL_KEY=
ELEVENLABS_API_KEY=
GROQ_API_KEY=
# Creatomate — renderização final do vídeo. Project Settings > API
CREATOMATE_API_KEY=

# ---- Orquestração do pipeline (Upstash QStash) ----
QSTASH_TOKEN=
# Assinatura dos callbacks que o QStash manda de volta pras etapas do
# pipeline — pegar junto com o QSTASH_TOKEN na região escolhida no console.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# URL pública do site em produção (sem barra no final) — usada pelo QStash
# e pela Creatomate pra saber pra onde entregar cada etapa/callback.
BASE_URL=https://www.fluxreel.com.br
