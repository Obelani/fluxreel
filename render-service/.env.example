# Variáveis desse serviço — configuradas como "secrets" no Fly.io
# (`fly secrets set NOME=valor`), não em nenhum painel da Vercel.

SUPABASE_URL=https://kbcagxxwhenqubbktsiv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Mesmo valor configurado em RENDER_SERVICE_SECRET na Vercel — é o que
